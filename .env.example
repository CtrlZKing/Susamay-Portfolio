# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional for initial preview; required for production Supabase deployment)
# Retrieve these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-do-not-expose-to-client"

# Admin Initial Seed
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="admin12345"
